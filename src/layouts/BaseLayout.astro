---
import "../styles/global.css";

type SigColor = "cyan" | "magenta" | "lime" | "orange";

interface Props {
	title: string;
	sigColor?: SigColor;
	chapterNum?: string;
	backHref?: string;
}

const {
	title,
	sigColor = "cyan",
	chapterNum,
	backHref = "../index.html",
} = Astro.props;
---

<html lang="en" data-sig={sigColor}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,800;1,9..144,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="issue max-w-[920px] mx-auto relative z-[1]">
			<header class="strip">
				{chapterNum ? (
					<>
						<a href={backHref} class="back">
							<span class="back-arrow">◂</span> BACK TO ISSUE
						</a>
						<span class="crumb">CH {chapterNum}</span>
						<span class="tint">REMY.EXE</span>
					</>
				) : (
					<span>★ REMY.EXE</span>
				)}
			</header>
			<slot />
		</div>

		<style>
			.strip {
				background: var(--color-bg-deep);
				color: var(--color-fg-soft);
				padding: 12px 20px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-family: var(--font-pixel);
				font-size: 10px;
				border: 2px solid var(--color-border);
				margin-bottom: 16px;
				gap: 14px;
				flex-wrap: wrap;
			}
			.strip .back {
				color: var(--sig);
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 8px;
				transition: color 0.15s;
			}
			.strip .back:hover {
				color: var(--color-yellow);
			}
			.strip .back:hover .back-arrow {
				transform: translateX(-3px);
			}
			.strip .back-arrow {
				display: inline-block;
				transition: transform 0.2s;
			}
			.strip .crumb,
			.strip .tint {
				color: var(--color-fg-mid);
			}
		</style>
	</body>
</html>
