---
/*
  M3 placeholder demo of BaseLayout. NOT the production cover.
  M8 replaces this file with the legacy cover HTML passthrough.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="REMY.EXE">
	<main class="mt-6">
		<h1 class="font-pixel text-xl mb-4">m3 baselayout demo</h1>
		<p class="font-serif text-lg mb-3">
			BaseLayout shell with default sigColor (cyan) and no chapterNum.
			This page is a placeholder; the real cover lands in M8 as a static
			passthrough from public/.
		</p>
		<div
			class="p-3"
			style="background: var(--sig-wash); border-left: 4px solid var(--sig); color: var(--sig);"
		>
			runtime sig: this strip's color comes from var(--sig) and var(--sig-wash).
		</div>
	</main>
</BaseLayout>
