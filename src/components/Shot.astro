---
interface Props {
	src: string;
	alt: string;
	label?: string;
	caption?: string;
}

const { src, alt, label, caption } = Astro.props;

// Relative path: chapter pages live at issue-01/{slug}.html, so
// `images/{src}` resolves to issue-01/images/{src} alongside the chapter.
// Keeps the site base-agnostic. Absolute or external URLs pass through.
const resolvedSrc =
	src.startsWith("/") || src.startsWith("http")
		? src
		: `images/${src}`;
---

<div class="shot">
	<div class="shot-img-wrap">
		<img src={resolvedSrc} alt={alt} />
	</div>
	{(label || caption) && (
		<div class="shot-caption">
			{label && <b>{label}</b>}
			{caption}
		</div>
	)}
</div>
